# βetaZuck — Vercel environment variables.
# Copy these into Vercel: Project → Settings → Environment Variables.
# Set scope to Production + Preview + Development.

# ── Site ───────────────────────────────────────────────────────
# Public origin of the deployed site. Sent as Origin/Referer when
# proxying to Nucleus and used as the post-checkout redirect base.
# Must be whitelisted on the Nucleus form receiver (otherwise 403).
PUBLIC_SITE_URL=https://YOUR-DOMAIN.com

# ── Campaign Nucleus ───────────────────────────────────────────
# Preferred: authenticated API token (Bearer) for api.campaignnucleus.com.
# When set, both petition signers and donors are pushed via
# POST /v1/profiles/match (proper CRM upsert with tags + custom fields).
# When unset, code falls back to the public form receiver URL below.
# Get from: Nucleus → Account / Settings / API Tokens.
# NUCLEUS_API_TOKEN=eyJ...

# Fallback: public form receiver URL for petition signers
# (Nucleus → Forms → your petition form → Receiver URL). Used if
# NUCLEUS_API_TOKEN is unset or the API call fails.
NUCLEUS_FORM_URL=https://teller.campaignnucleus.com/forms/receiver/d88908d2-afef-4e0a-aa9e-5c7280de75ba

# Optional: separate form receiver for donors. If unset, donors are
# posted to NUCLEUS_FORM_URL with source=betazuck-donor (or
# betazuck-monthly-donor) so you can segment in Nucleus.
# NUCLEUS_DONOR_FORM_URL=https://teller.campaignnucleus.com/forms/receiver/<uuid>

# ── Supabase ───────────────────────────────────────────────────
# Project Settings → API. Used for the live signature counter and
# the CMS content store / image uploads.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=eyJhbGc...                  # safe to expose; only used server-side here
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...          # SERVER ONLY — never ship to the browser

# ── CMS / Admin ────────────────────────────────────────────────
# Password for /admin. Treated as a Bearer token by /api/content (PUT)
# and /api/upload. Make this long and random; rotate by changing the
# value here and re-saving in Vercel. SERVER ONLY — never echo to
# clients other than via the admin login form (which compares it).
ADMIN_PASSWORD=use-a-long-random-string-here

# ── Stripe ─────────────────────────────────────────────────────
# Stripe Dashboard → Developers → API keys.
# Used by /api/checkout to create Checkout Sessions.
STRIPE_SECRET_KEY=sk_test_...                 # sk_live_... in production. SERVER ONLY.

# Stripe Dashboard → Developers → Webhooks → Add endpoint:
#   URL:    https://<your-domain>/api/stripe-webhook
#   Events: checkout.session.completed
# Copy the "Signing secret" (whsec_...) below. SERVER ONLY.
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Resend (transactional email) ───────────────────────────────
# Verify a sending domain at https://resend.com/domains first.
RESEND_API_KEY=re_...
EMAIL_FROM="βetaZuck <petition@yourdomain.com>"

# ── Cloudflare Turnstile (CAPTCHA) ─────────────────────────────
# Cloudflare dashboard → Turnstile → Add site
TURNSTILE_SITE_KEY=0x4AAAAAAA...              # public, returned by /api/config
TURNSTILE_SECRET_KEY=0x4AAAAAAA...            # SERVER ONLY
